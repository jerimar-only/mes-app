generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Auth ───────────────────────────────

enum UserRole {
  ADMINISTRATOR
  ENCODER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // used as the login username
  passwordHash String
  fullName     String
  role         UserRole @default(ENCODER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ─── Apprehension Tracking ──────────────────────

enum ApprehensionStatus {
  FOR_RESOLUTION
  UNDER_ADJUDICATION
  CONFISCATED
  DONATED
  RELEASED
  UNKNOWN
}

model CenroOffice {
  id      Int                  @id @default(autoincrement())
  name    String               @unique
  records ApprehensionRecord[]
}

model ApprehensionRecord {
  id                    Int                @id @default(autoincrement())
  cenroOfficeId         Int
  year                  Int
  month                 Int?               // 1–12, derived from dateOfApprehension when parseable
  dateOfApprehension    String?
  placeOfApprehension   String?
  circumstances         String?
  apprehendingAgency    String?            // e.g. "PNP Gattaran"
  claimantRespondent    String?            // e.g. "Alfredo B. Pavo"
  custodianLocation     String?
  otherAgencies         String?
  remarks               String?            @db.Text
  status                ApprehensionStatus @default(UNKNOWN)
  docketNumber          String?
  orderOfFinalityDate   String?
  isDeleted             Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  cenroOffice CenroOffice         @relation(fields: [cenroOfficeId], references: [id])
  items       ForestProductItem[]
  conveyances Conveyance[]
  equipment   Equipment[]
  fieldValues FieldValue[]

  @@index([cenroOfficeId])
  @@index([year])
  @@index([month])
  @@index([status])
}

model ForestProductItem {
  id                   Int      @id @default(autoincrement())
  apprehensionRecordId Int
  quantity              String?  // e.g. "7 & 1" (kept as text — source data mixes counts)
  species                String?  // e.g. "Gmelina", "Mahogany"
  forms                 String?  // e.g. "Lumber & Round logs", "Bed & TV Rack"
  description            String?  // free-text fallback / combined description
  volumeCuM              Float?
  volumeBdFt             Float?
  estimatedValue          Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

model Conveyance {
  id                   Int    @id @default(autoincrement())
  apprehensionRecordId Int
  type                  String? // e.g. "Utility vehicle"
  quantity               Int     @default(1)
  estimatedValue         Float?


  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

model Equipment {
  id                   Int    @id @default(autoincrement())
  apprehensionRecordId Int
  type                  String? // e.g. "Chainsaw with defaced serial number"
  quantity               Int     @default(1)
  estimatedValue         Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

// ─── Dynamic Custom Fields ───────────────────────

enum FieldType {
  TEXT
  NUMBER
}

model FieldDefinition {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  type      FieldType    @default(TEXT)
  order     Int          @default(0)
  disabled  Boolean      @default(false)
  createdAt DateTime     @default(now())
  values    FieldValue[]
}

model FieldValue {
  id                   Int      @id @default(autoincrement())
  apprehensionRecordId Int
  fieldDefinitionId    Int
  textValue            String?  @db.Text
  numberValue          Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])
  fieldDefinition    FieldDefinition    @relation(fields: [fieldDefinitionId], references: [id])

  @@unique([apprehensionRecordId, fieldDefinitionId])
  @@index([fieldDefinitionId])
}
