generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Auth ───────────────────────────────

enum UserRole {
  SUPERADMIN
  ADMINISTRATOR
  PENRO_ADMIN      // Scoped to one PenroOffice + its child CENROs
  CENRO_ADMIN      // Scoped to one CenroOffice
  ENCODER
  CENRO            // Portal account — scoped to one office
  REGIONAL         // View all + comment only (no edit/delete)
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique // used as the login username
  passwordHash  String
  fullName      String
  role          UserRole @default(ENCODER)

  /// Required when role = PENRO_ADMIN
  penroOfficeId Int?

  /// Required when role = CENRO_ADMIN or CENRO
  cenroOfficeId Int?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  penroOffice PenroOffice? @relation(fields: [penroOfficeId], references: [id])
  cenroOffice CenroOffice? @relation(fields: [cenroOfficeId], references: [id])
  comments    RecordComment[]

  @@index([penroOfficeId])
  @@index([cenroOfficeId])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  ip        String
  email     String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())
  country   String?
  region    String?
  city      String?
  userId    Int?

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// ─── Apprehension Tracking ──────────────────────

enum ApprehensionStatus {
  FOR_RESOLUTION
  UNDER_ADJUDICATION
  CONFISCATED
  DONATED
  RELEASED
  UNKNOWN
}

/// Condition of seized forest products (System Requirements §5)
enum ProductCondition {
  GOOD_CONDITION
  DETERIORATING
  DETERIORATED
}

/// Serviceability of conveyances / equipment (System Requirements §6–7)
enum AssetServiceStatus {
  SERVICEABLE
  UNSERVICEABLE
}

/// CENRO office — belongs to one PENRO (AOR) and has an optional default officer
model CenroOffice {
  id               Int    @id @default(autoincrement())
  name             String @unique
  /// Parent PENRO office (Area of Responsibility)
  penroOfficeId    Int?
  /// Default CENRO officer auto-filled on New Record when this office is selected
  defaultOfficerId Int?

  records      ApprehensionRecord[]
  users        User[]
  driveFolders DriveFolder[]

  penroOffice    PenroOffice?  @relation(fields: [penroOfficeId], references: [id], onDelete: SetNull)
  defaultOfficer CenroOfficer? @relation(fields: [defaultOfficerId], references: [id], onDelete: SetNull)

  @@index([penroOfficeId])
  @@index([defaultOfficerId])
}

/// Managed in Super Admin portal — powers New Record PENRO Office dropdown
model PenroOffice {
  id               Int    @id @default(autoincrement())
  name             String @unique
  /// Default PENRO officer auto-filled on New Record when this office is selected
  defaultOfficerId Int?

  cenroOffices CenroOffice[]
  users        User[]
  driveFolders DriveFolder[]

  defaultOfficer PenroOfficer? @relation(fields: [defaultOfficerId], references: [id], onDelete: SetNull)

  @@index([defaultOfficerId])
}

/// Managed in Super Admin portal — powers New Record PENRO Officer dropdown
model PenroOfficer {
  id   Int    @id @default(autoincrement())
  name String @unique

  penroOffices PenroOffice[]
}

/// Managed in Super Admin portal — powers New Record CENRO Officer dropdown
model CenroOfficer {
  id   Int    @id @default(autoincrement())
  name String @unique

  cenroOffices CenroOffice[]
}

model ApprehensionRecord {
  id Int @id @default(autoincrement())

  // 1. PENRO *
  penroOffice  String? // Batanes | Cagayan | Isabela | Quirino | Nueva Vizcaya
  penroOfficer String?

  // 2. CENRO *
  cenroOfficeId Int
  cenroOfficer  String?

  // 3. Date + time of apprehension
  year               Int
  month              Int? // 1–12, derived from dateOfApprehension when parseable
  dateOfApprehension String?
  timeOfApprehension String?

  // 4. Place + coordinates
  placeOfApprehension String?
  gpsCoordinates      String?

  // Legacy / supporting fields (kept for existing reports & imports)
  sourcePlace        String?
  landClassification String?
  circumstances      String?
  custodianLocation  String?
  otherAgencies      String?
  otherRemarks       String? @db.Text
  remarks            String? @db.Text
  caseStatus         String? @db.Text

  /// Google Drive link for case scans / PDFs (uploaded from the app)
  caseDocumentsUrl String?

  /// Google Drive link — appraisal report
  appraisalReportUrl String?

  /// Google Drive link — deed of donation
  deedOfDonationUrl String?

  /// Google Drive link — terminal report
  terminalReportUrl String?

  // 8. Apprehending officer *
  apprehendingAgency  String? // agency: PNP, LGU, DENR, etc.
  apprehendingOfficer String? // officer name (optional detail)

  // 9. Respondent / claimant * — YES → details; NO → stored as "Abandoned"
  hasRespondent      Boolean?
  claimantRespondent String? // name when hasRespondent = true; "Abandoned" when false
  respondentAddress  String?
  respondentContact  String?

  // 10. ACP conducted * — YES shows dates
  acpConducted       Boolean?
  acpDate            DateTime? @db.Date
  acpEndorsedToPenro DateTime? @db.Date
  acpEndorsedToRo    DateTime? @db.Date

  // 11–13. Promulgation + docket
  dateOfPromulgation  String?
  promulgatedBy       String?
  docketNumber        String?
  orderOfFinalityDate String?

  // 14–16. Appraisals *
  appraisalForestProducts     Boolean?
  appraisalForestProductsDate DateTime? @db.Date
  appraisalConveyances        Boolean?
  appraisalConveyancesDate    DateTime? @db.Date
  appraisalEquipment          Boolean?
  appraisalEquipmentDate      DateTime? @db.Date

  // 17. Mode of disposition — donation made *
  donationMade Boolean?

  // Donation — forest products
  donationFpDate   String?
  donationFpDonor  String?
  donationFpDonee  String?
  donationFpVolume String?

  // Donation / bid — conveyances
  donationConvDate  String?
  donationConvDonor String?
  donationConvDonee String?

  // Donation — equipment / implements
  donationEquipDate  String?
  donationEquipDonor String?
  donationEquipDonee String?

  status    ApprehensionStatus @default(UNKNOWN)
  isDeleted Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  cenroOffice CenroOffice         @relation(fields: [cenroOfficeId], references: [id])
  items       ForestProductItem[]
  conveyances Conveyance[]
  equipment   Equipment[]
  fieldValues FieldValue[]
  comments    RecordComment[]

  @@index([cenroOfficeId])
  @@index([year])
  @@index([month])
  @@index([status])
  @@index([penroOffice])
}

model ForestProductItem {
  id                   Int @id @default(autoincrement())
  apprehensionRecordId Int

  /// TYPE — logs, flitches, lumber, rattan, etc. (was: forms)
  type String?
  /// NUMBER OF PIECES
  quantity String?
  /// Species (optional supporting field)
  species String?
  /// Free-text description fallback
  description String?
  /// VOLUME — board feet
  volumeBdFt Float?
  /// VOLUME — cubic meters
  volumeCuM Float?
  /// STATUS — good / deteriorating / deteriorated
  conditionStatus ProductCondition?
  /// ESTIMATED VALUE (Php)
  estimatedValue Float?
  /// @deprecated use `type` — kept for older rows
  forms String?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

model Conveyance {
  id                   Int @id @default(autoincrement())
  apprehensionRecordId Int

  /// TYPE — motorcycle, kulong-kulong, etc.
  type String?
  /// PLATE NO. *
  plateNo String?
  /// STATUS — serviceable / unserviceable
  serviceStatus  AssetServiceStatus?
  quantity       Int                 @default(1)
  estimatedValue Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

model Equipment {
  id                   Int @id @default(autoincrement())
  apprehensionRecordId Int

  /// TYPE — chainsaw, etc.
  type String?
  /// REGISTERED * YES / NO
  registered Boolean?
  /// STATUS — serviceable / unserviceable
  serviceStatus  AssetServiceStatus?
  quantity       Int                 @default(1)
  estimatedValue Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])

  @@index([apprehensionRecordId])
}

// ─── Dynamic Custom Fields ───────────────────────

enum FieldType {
  TEXT
  NUMBER
}

model FieldDefinition {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  type      FieldType @default(TEXT)
  order     Int       @default(0)
  disabled  Boolean   @default(false)
  createdAt DateTime  @default(now())

  values FieldValue[]
}

model FieldValue {
  id                   Int     @id @default(autoincrement())
  apprehensionRecordId Int
  fieldDefinitionId    Int
  textValue            String? @db.Text
  numberValue          Float?

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id])
  fieldDefinition    FieldDefinition    @relation(fields: [fieldDefinitionId], references: [id])

  @@unique([apprehensionRecordId, fieldDefinitionId])
  @@index([fieldDefinitionId])
}

// ─── Comments (Regional Office + others) ─────────

model RecordComment {
  id                   Int      @id @default(autoincrement())
  apprehensionRecordId Int
  userId               Int
  content              String   @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  apprehensionRecord ApprehensionRecord @relation(fields: [apprehensionRecordId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id])

  @@index([apprehensionRecordId])
  @@index([userId])
}

// ─── Google Drive Folder Management (SA only) ────

enum FolderType {
  ROOT
  PENRO
  CENRO
  OTHER
}

model DriveFolder {
  id            Int        @id @default(autoincrement())
  name          String     // display name
  driveId       String     // Google Drive folder ID
  type          FolderType
  penroOfficeId Int?
  cenroOfficeId Int?
  parentId      Int?       // optional hierarchy
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  penroOffice PenroOffice? @relation(fields: [penroOfficeId], references: [id], onDelete: SetNull)
  cenroOffice CenroOffice? @relation(fields: [cenroOfficeId], references: [id], onDelete: SetNull)
  parent      DriveFolder? @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    DriveFolder[] @relation("FolderHierarchy")

  @@index([penroOfficeId])
  @@index([cenroOfficeId])
  @@index([parentId])
  @@index([type])
}

// ─── App settings (Google Drive tokens, parent folder, etc.) ───

model Setting {
  key   String @id
  value String
}
